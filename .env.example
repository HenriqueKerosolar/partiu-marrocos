# --- Banco de dados ---
# DEV: Postgres local via Docker (ver docker-compose.yml). Uma única role
# (partiumarrocos_app) para migrations e runtime — o isolamento por tenant é
# garantido por Row Level Security (current_tenant_id()/rls_bypass(), ver
# packages/db/prisma/rls.sql), não por troca de role Postgres. Mesmo padrão
# do CongáOne/MercadoEase.
#
# PRODUÇÃO (Vercel): o app é hospedado na Vercel (decidido 2026-09-16), que é
# serverless — não roda o container do docker-compose.yml ao lado da
# aplicação. O banco de produção precisa ser um Postgres gerenciado
# compatível com serverless (ex.: Neon, que é vanilla Postgres — preserva a
# RLS já implementada sem exigir migração de arquitetura). Nesse cenário:
# - DATABASE_URL: connection string PGBOUNCER/pooled do provedor (o app usa
#   muitas conexões curtas em serverless — sem pool, esgota o Postgres).
# - DIRECT_URL: connection string direta (sem pooler) do MESMO banco, usada
#   só por `prisma migrate deploy` (migrations não funcionam bem via pooler).
# Em dev local, as duas apontam para o mesmo Postgres do Docker — não há
# pooler local, é só para o schema do Prisma aceitar `directUrl` sem quebrar.
# Conta/credenciais do provedor de produção ainda não foram criadas — é uma
# ação que só o usuário pode fazer (nunca o agente).
DATABASE_URL="postgresql://partiumarrocos_app:partiumarrocos_app_pw@127.0.0.1:5434/partiumarrocos?schema=public"
DIRECT_URL="postgresql://partiumarrocos_app:partiumarrocos_app_pw@127.0.0.1:5434/partiumarrocos?schema=public"

# --- Auth ---
# Gere um valor forte por ambiente, ex: `openssl rand -base64 48`
JWT_SECRET="troque-este-valor-em-cada-ambiente"
SESSION_COOKIE_NAME="partiumarrocos_session"

# --- Secret Provider (PM-BLOQ-001) ---
# "local" é a única implementação disponível nesta rodada (não depende de
# nenhum serviço de nuvem nem de Windows/DPAPI — ver
# packages/db/src/secret-provider.ts). Master key de 32 bytes em base64,
# usada para cifrar/decifrar segredos de tenant (AES-256-GCM) — gere uma por
# ambiente, nunca reaproveite a de dev: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SECRET_PROVIDER="local"
SECRET_PROVIDER_MASTER_KEY="troque-este-valor-em-cada-ambiente-32-bytes-base64"

# --- Site público (site-original/, estático, hospedagem própria) ---
# Origem exata do site público em produção, pra CORS de
# apps/web/src/app/api/public/leads/route.ts (o formulário de orçamento do
# site chama esse endpoint entre domínios). Em dev fica "*" por padrão —
# defina o domínio real antes de publicar.
PUBLIC_SITE_ORIGIN="*"

# --- App ---
NODE_ENV="development"
